        "        if marker is not None and len(all_instances) == 0:",
        "            # NOTE(danms): If we did not find the marker in any cell,",
        "            # mimic the db_api behavior here",
        "            raise exception.MarkerNotFound(marker=marker)",
        "",
        "        return all_instances",
