      "b": [
        "    def calculate_virtual_machine_usage_hours(self, context, instance,",
        "                                              period_start, period_stop,",
        "                                              override_account_configs=None):",
        "        if period_start:",
        "            period_start = period_start.replace(tzinfo=iso8601.UTC)",
        "",
        "        if period_stop:",
        "            period_stop = period_stop.replace(tzinfo=iso8601.UTC)",
        "",
        "        instance_events = []",
        "        try:",
        "            instance_events = objects.InstanceActionList.get_by_instance_uuid(",
        "                context, instance.uuid, filters=None, sort_dirs=['asc', 'asc'])",
        "        except StopIteration as s:",
        "            LOG.debug(\"StopIteration [%s] happened while\"",
        "                      \" retrieving instance [id=%s] events.\", s, instance.uuid)",
        "",
        "        if not instance_events:",
        "            return self.calculate_virtual_machine_usage_hours_without_event(",
        "                period_start, period_stop, instance)",
        "",
        "        return self.account_server_usage_hours_with_events(",
        "            instance_events, period_start, period_stop, instance,",
        "            override_account_configs)",
        "",
        "    @staticmethod",
        "    def account_server_usage_hours_with_events(instance_events,",
        "                                               period_start, period_stop,",
        "                                               instance,",
        "                                               override_account_configs=None):",
        "        instance_usage_hours = 0",
        "",
        "        vm_uuid = instance.uuid",
        "        vm_current_state = None",
        "        vm_start_date = None",
        "",
        "        LOG.debug(\"Accounting usage for VM [%s] with events [%s].\", instance,",
        "                  instance_events)",
        "",
        "        if not override_account_configs:",
        "            override_account_configs = {",
        "                \"all_start_account_hours_event\": list(map(",
        "                    str.strip,",
        "                    CONF.api.all_start_account_hours_actions.split(\",\"))),",
        "                \"all_stop_account_hours_event\": list(map(",
        "                    str.strip,",
        "                    CONF.api.all_stop_account_hours_actions.split(\",\")))",
        "            }",
        "",
        "        LOG.debug(\"Using actions [%s] to indicate when the accounting \"",
        "                  \"for VM usage is started.\",",
        "                  override_account_configs[\"all_start_account_hours_event\"])",
        "        LOG.debug(\"Using actions [%s] to indicate when the accounting \"",
        "                  \"for VM usage is stopped.\",",
        "                  override_account_configs[\"all_stop_account_hours_event\"])",
        "",
        "        for event in instance_events:",
        "            if event.action not in \\",
        "                    override_account_configs[\"all_start_account_hours_event\"] \\",
        "                    + \\",
        "                    override_account_configs[",
        "                        \"all_stop_account_hours_event\"]:",
        "                LOG.debug(\"VM [%s] has an event [%s] that is neither a start \"",
        "                          \"account nor a stop account event. Therefore, we \"",
        "                          \"ignore it.\", vm_uuid, event.action)",
        "                continue",
        "",
        "            event_time = SimpleTenantUsageController.get_event_time(event)",
        "            if event_time <= period_start:",
        "                LOG.debug(\"Change VM [%s] state before period from [%s] \"",
        "                          \"to [%s].\", vm_uuid, vm_current_state, event.action)",
        "                vm_current_state = event.action",
        "",
        "                if event.action in override_account_configs[",
        "                        \"all_start_account_hours_event\"]:",
        "                    LOG.debug(",
        "                        \"The event [%s] is a start event that happened \"",
        "                        \"before the usage search period. Therefore, \"",
        "                        \"we set the very first time to account usage to \"",
        "                        \"the usage search start period.\", event.action)",
        "                    vm_start_date = period_start",
        "                continue",
        "",
        "            if event_time > period_stop:",
        "                LOG.debug(\"Ignoring event [%s] that happened out of the\"",
        "                          \" defined period [start=%s, stop%s].\", event,",
        "                          period_start, period_stop)",
        "                continue",
        "            if not vm_current_state:",
        "                vm_current_state = event.action",
        "                LOG.debug(\"VM [%s] did not have a state when entering the \"",
        "                          \"period[start=%s,stop=%s]. Therefore, we assign \"",
        "                          \"the current state [%s] to it.\", instance,",
        "                          period_start, period_stop, event.action)",
        "",
        "            if vm_current_state in override_account_configs[",
        "                    \"all_start_account_hours_event\"]:",
        "                if event.action in override_account_configs[",
        "                        \"all_stop_account_hours_event\"]:",
        "                    if vm_start_date is None:",
        "                        LOG.debug(\"A stop event [%s] without storing the start\"",
        "                                  \" event timestamp. We will assume that the\"",
        "                                  \" VM was already running before the filter\"",
        "                                  \" period.\", event)",
        "                        vm_start_date = period_start",
        "",
        "                    instance_usage_hours_start_stop_block = \\",
        "                        (event_time - vm_start_date).total_seconds()",
        "                    instance_usage_hours += \\",
        "                        instance_usage_hours_start_stop_block",
        "",
        "                    vm_start_date = None",
        "                    vm_current_state = event.action",
        "                elif not vm_start_date:",
        "                    LOG.debug(\"The VM [id=%s] was started in\"",
        "                              \" the period with event [%s].\", vm_uuid, event)",
        "                    vm_start_date = event_time",
        "                else:",
        "                    LOG.debug(\"VM running [id=%s] event [%s] discarded\"",
        "                              \" in datetime [%s].\",",
        "                              vm_uuid, event.action, event_time)",
        "            elif vm_current_state in override_account_configs[",
        "                    \"all_stop_account_hours_event\"]:",
        "                if event.action in override_account_configs[",
        "                        \"all_start_account_hours_event\"]:",
        "                    vm_current_state = event.action",
        "                    vm_start_date = event_time",
        "                else:",
        "                    LOG.debug(\"Non-running VM [id=%s] event [%s] discarded\"",
        "                              \" in datetime [%s].\",",
        "                              vm_uuid, event.action, event_time)",
        "            else:",
        "                LOG.debug(\"Unknown VM state [id=%s] event [%s] discarded\"",
        "                          \" in datetime [%s].\",",
        "                          vm_uuid, event.action, event_time)",
        "",
        "        if vm_start_date and vm_current_state in override_account_configs[",
        "                \"all_start_account_hours_event\"]:",
        "            instance_usage_hours_start_stop_block = \\",
        "                (period_stop - vm_start_date.replace(",
        "                    tzinfo=iso8601.UTC)).total_seconds()",
        "            instance_usage_hours += \\",
        "                instance_usage_hours_start_stop_block",
        "        return instance_usage_hours / 3600",
        "",
        "    @staticmethod",
        "    def calculate_virtual_machine_usage_hours_without_event(period_start,",
        "                                                            period_stop,",
        "                                                            instance):",
        "        vm_current_state = instance.vm_state",
        "        vm_uuid = instance.uuid",
        "",
        "        LOG.debug(\"No events found for VM [id=%s] in the period \"",
        "                  \"[begin=%s, end=%s].\", vm_uuid, period_start,",
        "                  period_stop)",
        "        if vm_current_state != 'active':",
        "            LOG.debug(\"VM [id=%s] does not have events in the given\"",
        "                      \" period[begin=%s, end=%s], and its state [%s]\"",
        "                      \" is not active. Therefore, we assume that it\"",
        "                      \" has not been running in the given period.\",",
        "                      vm_uuid, period_start, period_stop,",
        "                      vm_current_state)",
        "            return 0",
        "        else:",
        "            LOG.debug(\"VM [id=%s] does not have events in the given\"",
        "                      \" period[begin=%s, end=%s], and its state is\"",
        "                      \" active. Therefore, we assume that it\"",
        "                      \" has been running the whole given period.\",",
        "                      vm_uuid, period_start, period_stop)",
        "            return (period_stop - period_start).total_seconds() / 3600",
        "",
