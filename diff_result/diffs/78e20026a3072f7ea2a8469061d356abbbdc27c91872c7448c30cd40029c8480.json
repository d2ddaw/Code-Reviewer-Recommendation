        "    def get_event_time(event):",
        "        current_state_time = event.start_time",
        "        if not isinstance(current_state_time, datetime.datetime):",
        "            current_state_time = timeutils.parse_isotime(current_state_time)",
        "        return current_state_time",
        ""
      ]
